# Configuration file - add to .gitignore
# This file can be used to store environment variables

# Flask configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Camera configuration
DEFAULT_CAMERA_SOURCE=0
# For IP camera, use RTSP URL: rtsp://username:password@ip:port/path

# Application paths
UPLOAD_FOLDER=uploads
SETTINGS_FOLDER=settings
GCODE_FOLDER=gcode
